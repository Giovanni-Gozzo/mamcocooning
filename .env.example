# ── Espace privé (obligatoire pour se connecter à /admin) ─────────────────────
# Générez les deux valeurs avec : npm run hash:password "votre mot de passe"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ── Base de données Neon Postgres ────────────────────────────────────────────
# Vercel > Storage > Create Database > Neon. La variable est ajoutée toute seule.
DATABASE_URL=

# ── Stockage des photos (Vercel Blob) ────────────────────────────────────────
# Vercel > Storage > Create Database > Blob. La variable est ajoutée toute seule.
BLOB_READ_WRITE_TOKEN=

# ── Classement automatique par Gemini ────────────────────────────────────────
# Clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Photos depuis la page Facebook (facultatif) ──────────────────────────────
# Voir la section « Photos depuis Facebook » du README pour obtenir ces valeurs.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Seuls les posts contenant ce hashtag arrivent sur le site (défaut : site).
FACEBOOK_HASHTAG=site
# Protège la tâche planifiée quotidienne. Une longue chaîne aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Divers ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mamcocooning.fr
